NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The dashboard's "Retention" nav item links straight out to this URL --
# it deliberately does NOT get its own page in this app (see docs/ui.md /
# docs/architecture.md's "dashboard-agnostic" commitment). Leave blank to
# have the link render as a dead "#" until this is set.
NEXT_PUBLIC_RETENTION_DASHBOARD_URL=

# Service role key -- server-only, NEVER prefixed NEXT_PUBLIC_, never sent
# to a browser. Same value the Python pipeline uses (see root .env.example
# / docs/secrets.md). Required for: the Excel report download route
# (src/app/api/reports/[clientId]/route.ts) and the admin "create user"
# action (src/app/dashboard/admin/actions.ts), which needs the Supabase
# Auth Admin API to create real accounts -- there's no RLS-sanctioned way
# to do that with the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shopify client onboarding (admin Clients page > connections > Connect Shopify).
# The app's Client ID is public; its Client Secret is NOT set here -- it lives
# in Supabase Vault as `agency.shopify.client_secret` (set it yourself with
# scripts/set_vault_secret.py, hidden prompt). SITE_URL is where this app is
# served from; Shopify redirects to ${SITE_URL}/api/shopify/callback, and that
# exact URL must be listed as an allowed redirect URL on the Shopify app.
SHOPIFY_CLIENT_ID=
SITE_URL=http://localhost:3000
# Optional; defaults to read_orders,read_customers,read_products,read_reports
# SHOPIFY_SCOPES=

# WhatsApp bot (docs/notifications.md): the sending number's "Phone number ID"
# from WhatsApp Manager (not secret). The access token, app secret and webhook
# verify token live in Vault: agency.whatsapp.access_token / .app_secret / .verify_token
WHATSAPP_PHONE_NUMBER_ID=

# Connect Meta (Facebook Login on the Meta app): the app's ID (not secret) and the
# permissions requested. The app secret is read from Vault (agency.meta.app_secret,
# or the WhatsApp copy). Add ${SITE_URL}/api/meta/callback as a valid OAuth redirect
# URI in the Meta app.
META_APP_ID=
# META_LOGIN_SCOPES=ads_read,business_management
