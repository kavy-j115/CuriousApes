# Copy this file to .env and fill in real values.
# .env is git-ignored — it never gets committed. This file (.env.example) is the
# only one that goes into git, so anyone cloning the repo knows what variables exist
# without ever seeing a real secret.
#
# Per-client credentials (Shopify tokens, Meta tokens, GA4 service account
# keys) do NOT live here anymore -- they're stored in Supabase Vault (see
# docs/secrets.md) and set via scripts/set_vault_secret.py. This file only
# holds the handful of values needed to bootstrap a connection to Supabase
# in the first place, plus anything genuinely not per-client.

# --- Database (Supabase Postgres) ---
# Found in Supabase project settings -> Database -> Connection string (URI format).
# This is the ONE credential that has to live outside the database itself --
# it's what the pipeline uses to *reach* Supabase (and therefore Vault) at all.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# --- AI (added at Milestone 10) ---
ANTHROPIC_API_KEY=

# --- Report storage (uploads generated reports to Supabase Storage for
# download from the UI) ---
# SUPABASE_URL is the project URL (same host as DATABASE_URL, e.g.
# https://xxxxx.supabase.co) -- NOT the same value as web/.env.local's
# NEXT_PUBLIC_SUPABASE_URL variable, though it IS the same underlying value;
# kept as a separate var since this one is never meant to reach a browser.
# SERVICE_ROLE_KEY is highly sensitive -- bypasses RLS entirely. Server-side
# only, never in web/.env.local, never in a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
