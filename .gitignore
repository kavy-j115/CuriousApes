# Secrets — never commit real credentials
.env
config/clients/*.local.yaml

# Python
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Reports & generated output (these are outputs, not source — regenerated by the pipeline)
reports/output/
*.xlsx
!docs/**/*.xlsx

# OS / editor noise
.DS_Store
.vscode/
.idea/

# Logs
*.log

# Loose working files at the repo root (decks, overview notes, screenshots, logo drafts) -- not source
/PROJECT_OVERVIEW.md
/*.pptx
/*.png
